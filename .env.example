# Скопируйте в .env и подставьте свои значения. .env в репозиторий не попадает.
# Строку подключения и пароль берите в Supabase → Project Settings → Database.

DB_DSN=pgsql:host=<host>.pooler.supabase.com;port=6543;dbname=postgres;sslmode=require
DB_USER=postgres.<project-ref>
DB_PASS=<database-password>

# Ключ Groq (единственный провайдер генерации): https://console.groq.com/keys
# Без него генерация работает в демо-режиме и возвращает заглушку.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Secure-флаг у cookie сессии определяется по запросу; здесь можно форсировать
# COOKIE_SECURE=true
